{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",

      "Bash(python3 tools/project.py commit *)",
      "Bash(PYTHONPATH=src python3 -m pytest *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/panel_hook.py",
            "timeout": 12,
            "statusMessage": "加载项目状态面板..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .codex/hooks/clean_checkpoint_first.py stop",
            "timeout": 30,
            "statusMessage": "检查 clean-checkpoint 状态..."
          }
        ]
      }
    ]
  }
}
