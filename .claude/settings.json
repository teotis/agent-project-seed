{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git worktree *)",
      "Bash(git rm *)",
      "Bash(git show *)",

      "Bash(python3 tools/project.py commit *)",
      "Bash(PYTHONPATH=src python3 -m pytest *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/panel_hook.py",
            "timeout": 12,
            "statusMessage": "加载项目状态面板..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/project.py commit --message \"chore: checkpoint agent work\"",
            "timeout": 30,
            "statusMessage": "生成本地 checkpoint commit..."
          }
        ]
      }
    ]
  }
}
