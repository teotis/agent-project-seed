{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/panel_hook.py",
            "timeout": 12,
            "statusMessage": "Loading project status panel…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/project.py commit --message \"chore: checkpoint agent work\""
          }
        ]
      }
    ]
  }
}
